APP_ENV=development
LAB_MODE=secure
DATABASE_URL=sqlite:///./booking_lab.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai-booking-frontend-k40y.onrender.com
# Optional seed account; use non-sensitive credentials on example.test only.
SEED_NAME=Lab User
SEED_EMAIL=
SEED_PASSWORD=
# Optional OpenAI-compatible chat completions. All three are required to enable it.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=5
